{
  "name": "@magicdoor/magic-use-case-solid",
  "version": "0.1.1",
  "description": "SolidJS bindings for magic-use-case — clean-architecture use cases and presenters for front-end TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "worker": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server.js"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "deno": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --project typecheckconfig.json",
    "check-package": "attw --pack . --ignore-rules cjs-resolves-to-esm && publint --strict",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "solid-js": ">1.9.3"
  },
  "devDependencies": {
    "@magicdoor/magic-use-case-core": "*",
    "@solidjs/testing-library": "^0.8.10",
    "eslint-plugin-solid": "^0.14.5",
    "solid-js": "^1.9.3",
    "tsup-preset-solid": "^2.2.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "keywords": [
    "solidjs",
    "use-case",
    "clean-architecture",
    "presenter",
    "state-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicDoorInc/magic-use-case.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/MagicDoorInc/magic-use-case#readme",
  "bugs": {
    "url": "https://github.com/MagicDoorInc/magic-use-case/issues"
  },
  "author": "Norbert Nemes",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
