{
  "name": "@magicdoor/eslint-plugin",
  "version": "0.2.0",
  "description": "ESLint rules and configs for TypeScript front ends: hygiene for any app, layer boundaries for layered ones, and the rules magic-use-case relies on.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --project typecheckconfig.json",
    "check-package": "attw --pack . --ignore-rules cjs-resolves-to-esm && publint --strict",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/utils": "^8.70.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/rule-tester": "^8.70.1"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "use-case",
    "clean-architecture",
    "presenter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicDoorInc/magic-use-case.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/MagicDoorInc/magic-use-case#readme",
  "bugs": {
    "url": "https://github.com/MagicDoorInc/magic-use-case/issues"
  },
  "author": "Norbert Nemes",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
