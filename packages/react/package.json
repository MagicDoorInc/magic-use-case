{
  "name": "@magicdoor/magic-use-case-react",
  "version": "0.1.0",
  "description": "React bindings for magic-use-case \u2014 clean-architecture use cases and presenters for front-end TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --project typecheckconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@magicdoor/magic-use-case-core": "*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.2.8"
  },
  "keywords": [
    "react",
    "use-case",
    "clean-architecture",
    "presenter",
    "state-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicDoorInc/magic-use-case.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/MagicDoorInc/magic-use-case#readme",
  "bugs": {
    "url": "https://github.com/MagicDoorInc/magic-use-case/issues"
  },
  "author": "Norbert Nemes",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
